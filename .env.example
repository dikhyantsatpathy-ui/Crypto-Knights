# ============================================================
# No Cap Provenance Engine - Environment Template
# Copy to `.env`, fill in real values, and NEVER commit `.env`.
# ============================================================

# Neon Postgres (or any SQLAlchemy-compatible DB)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# 32+ byte master key for the KMS (AES-256-GCM) vault.
# WARNING: Changing this AFTER identities are registered makes their KMS keys undecryptable.
MASTER_VAULT_KEY=

# Google OAuth 2.0 Client ID used to authenticate signers
GOOGLE_CLIENT_ID=

# --- Who may log in (authorization gate). Driven by Google Cloud itself,
#     NOT a hardcoded list in code. ---
# Comma-separated Google-hosted domains (matches the id_token `hd` claim).
# Anyone whose Google account belongs to one of these domains is allowed
# automatically — add/remove users in Google Cloud and it just works:
ALLOWED_DOMAINS=
# Optional comma-separated exact emails (for personal gmail accounts, which
# carry no `hd` domain claim):
# ALLOWED_EMAILS=person@gmail.com,other@gmail.com
# SUPER_ADMINS always bypass the gate, so the owner can never be locked out.

# --- Optional: Layer-2 Web3 anchoring (leave blank for simulated mode) ---
WEB3_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_API_KEY
WALLET_PRIVATE_KEY=0x

# --- Optional: Pinata IPFS (leave blank for simulated receipt CIDs) ---
PINATA_JWT=

# --- Optional: override block explorer link base ---
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com/tx/

# --- Optional: Neon keep-alive pinger interval in seconds (0 disables) ---
KEEPALIVE_INTERVAL=45