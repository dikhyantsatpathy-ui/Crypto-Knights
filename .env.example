# ============================================================
# No Cap Provenance Engine - Environment Template
# Copy to `.env`, fill in real values, and NEVER commit `.env`.
# ============================================================

# Neon Postgres (or any SQLAlchemy-compatible DB)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# 32+ byte master key for the KMS (AES-256-GCM) vault.
# WARNING: Changing this AFTER identities are registered makes their KMS keys undecryptable.
MASTER_VAULT_KEY=

# Google OAuth 2.0 Client ID used to authenticate signers
GOOGLE_CLIENT_ID=

# --- Who may log in (authorization gate). Driven by Google Cloud itself,
#     NOT a hardcoded list in code. ---
# Comma-separated domains, matches BOTH the id_token `hd` claim (Google
# Workspace) AND the email's own "@domain" suffix. Anyone whose account is in
# one of these domains is allowed automatically — add/remove people in Google
# Cloud (Workspace) and they get in with no code change. This is the ONLY way
# gmail-style accounts are "auto-enabled" (they have no hd claim), and it is
# NOT set here so NOT every gmail account can log in:
ALLOWED_DOMAINS=
# Comma-separated exact emails allowed to log in (your vetted allowlist).
# Anyone NOT a super admin AND NOT in ALLOWED_EMAILS/ALLOWED_DOMAINS is
# rejected with a 401 at login:
# ALLOWED_EMAILS=person@gmail.com,other@gmail.com
# SUPER_ADMINS always bypass the gate, so the owner can never be locked out.
# SUPER_ADMINS always bypass the gate, so the owner can never be locked out.

# --- Optional: Layer-2 Web3 anchoring (leave blank for simulated mode) ---
WEB3_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_API_KEY
WALLET_PRIVATE_KEY=0x

# --- Optional: Pinata IPFS (leave blank for simulated receipt CIDs) ---
PINATA_JWT=

# --- Optional: override block explorer link base ---
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com/tx/

# --- Optional: Neon keep-alive pinger interval in seconds (0 disables) ---
KEEPALIVE_INTERVAL=45

# ---
# Real registry verification adapters (app/verification_providers.py)
# Leaving these blank keeps every registry on the deterministic MOCK, which is
# the correct default until you onboard a licensed API provider for each agency
# (see VERIFICATION_PROVIDERS.md). Set the *_URL of any registry you have real
# credentials for; that single registry goes LIVE, the others stay mock.
#
# REGKEY is one of: PAN_NSDL, DL_PARIVAHAN, RC_VAHAN, EPIC_EC, PASSPORT_REGISTRY
# ---
# IDV_PAN_NSDL_URL=https://api.example.com/pan/verify
# IDV_PAN_NSDL_TOKEN=
# IDV_DL_PARIVAHAN_URL=
# IDV_RC_VAHAN_URL=
# IDV_EPIC_EC_URL=
# IDV_PASSPORT_REGISTRY_URL=
# --- Optional per-registry overrides of the JSON contract ---
# IDV_PAN_NSDL_NUMBER_FIELD=number
# IDV_PAN_NSDL_NAME_FIELD=name
# IDV_PAN_NSDL_RESP_EXISTS=exists
# IDV_PAN_NSDL_RESP_STATUS=status
# IDV_PAN_NSDL_RESP_NAME=name
# IDV_PAN_NSDL_REQUEST_EXTRA={"partner_id":"YOUR_ID"}
# --- Global HTTP knobs ---
# IDV_TOKEN=
# IDV_AUTH_HEADER=Authorization
# IDV_AUTH_SCHEME=Bearer
# IDV_TIMEOUT=12

# --- UIDAI Aadhaar offline-SecureQR signature key (PEM). Unset => signature
#     verification is skipped and only checksum+structural checks run. ---
# UIDAI_AADHAAR_PUBKEY_PEM=
# Accepts a bare public key OR a full X.509 .cer certificate (the form UIDAI
# distributes keys in) — paste the PEM text or a path to the file.

# ---
# DigiLocker issued-document provider (app/digilocker_provider.py).
# Register a Requester app with DigiLocker (NeGD), then set these two to go
# live. Unset => deterministic mock. Holder OAuth consent is required per
# lookup — without a holder token the provider answers "consent required",
# never holder data.
# ---
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://your-app/callback
# DIGILOCKER_TOKEN_URL=https://api.digilocker.gov.in/public/oauth2/1/token
# DIGILOCKER_API_BASE=https://api.digilocker.gov.in
# DIGILOCKER_FILES_PATH=/public/oauth2/2/files
# DIGILOCKER_TIMEOUT=12

# --- Face-match embedding model (app/face_match.py). Unset => whole-image
#     perceptual dHash via Pillow (works on Vercel today, coarse). Point at an
#     ArcFace/FaceNet-style .onnx + install onnxruntime (local/worker only)
#     for production-grade QR-portrait vs selfie comparison. ---
# FACE_EMBED_MODEL=